        "body": {
          "mode": "raw",
          "raw": "{\n  \"nom\": \"Agence Test 271\",\n  \"code\": \"T271\",\n  \"groupeId\": \"{{groupeId}}\",\n  \"zoneDistributionId\": 1,\n  \"prestataire\": \"BRINKS\",\n  \"coutDeplacement\": 350.0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"success = true\", () => pm.expect(pm.response.json().success).to.eql(true));",
              "const d = pm.response.json().data; pm.collectionVariables.set(\"agenceId\", d.id);",
              "pm.test(\"3 champs 271 présents\", () => { pm.expect(d.zoneDistribution.id).to.eql(1); pm.expect(d.prestataire.id).to.eql(\"BRINKS\"); pm.expect(Number(d.coutDeplacement)).to.eql(350); });"
            ]
          }
        }
      ]
