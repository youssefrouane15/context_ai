{
  "info": {
    "name": "AER_LM-270 — Zones de distribution",
    "description": "Référentiel zones de distribution — utilisateurs-ci",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Mode local (qf.security.auth-mode = mock) : QfSimplifiedAuthFilter lit seulement le claim `sub`",
          "// et ne verifie pas la signature. On fabrique donc un JWT HS256 avec sub = {{uid}} a chaque appel.",
          "const uid = pm.collectionVariables.get('uid') || 'h11111';",
          "const b64url = words => CryptoJS.enc.Base64.stringify(words).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
          "const header  = b64url(CryptoJS.enc.Utf8.parse(JSON.stringify({ alg: 'HS256', typ: 'JWT' })));",
          "const payload = b64url(CryptoJS.enc.Utf8.parse(JSON.stringify({ sub: uid, iss: 'postman-mock', iat: Math.floor(Date.now() / 1000), exp: Math.floor(Date.now() / 1000) + 3600 })));",
          "const signature = b64url(CryptoJS.HmacSHA256(header + '.' + payload, 'mock-secret'));",
          "pm.collectionVariables.set('token', header + '.' + payload + '.' + signature);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Listing initial",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/public/users/referentiels/zones-distribution",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "public",
            "users",
            "referentiels",
            "zones-distribution"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"success = true\", () => pm.expect(pm.response.json().success).to.eql(true));",
              "pm.test(\"2 zones seedées, triées par libellé\", () => { const d = pm.response.json().data; pm.expect(d.length).to.be.at.least(2); pm.expect(d[0].nom.localeCompare(d[1].nom)).to.be.at.most(0); });"
            ]
          }
        }
      ]
    },
