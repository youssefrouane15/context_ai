<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0"
                  xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_Derogation"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">

  <bpmn:process id="Process_Derogation" name="Demande de dérogation" isExecutable="true" camunda:historyTimeToLive="180">

    <bpmn:laneSet id="LaneSet_Actors">
      <bpmn:lane id="Lane_Reseau" name="Réseau — Conseiller / RM ou DA">
        <bpmn:flowNodeRef>StartEvent_NouvelleDemande</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Soumission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InitieeParConseiller</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReponseReseau</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReponseAcceptee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EditionRecap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_FinWorkflow</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DA" name="Directeur d'Agence">
        <bpmn:flowNodeRef>Task_ValidationDA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionDA</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DIE" name="DIE">
        <bpmn:flowNodeRef>Task_ValidationDIE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionDIE</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_LigneMetier" name="Ligne Métier">
        <bpmn:flowNodeRef>Task_LigneMetier</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AnalyseComplete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- Start -->
    <bpmn:startEvent id="StartEvent_NouvelleDemande" name="Demande reçue">
      <bpmn:outgoing>Flow_Start_Soumission</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Soumission -->
    <bpmn:userTask id="Task_Soumission"
                   name="Soumettre demande"
                   camunda:candidateGroups="conseiller,da">
      <bpmn:documentation>Conseiller/RM ou DA — Soumission de la demande de dérogation.
Point de retour unique du parcours : complément demandé par le DA, complément demandé par le DIE,
analyse incomplète de la Ligne Métier, ou refus de la réponse par le réseau.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="initiateur" label="Initiateur de la demande" type="enum">
            <camunda:value id="conseiller" name="Conseiller / RM" />
            <camunda:value id="da" name="Directeur d'Agence" />
          </camunda:formField>
        </camunda:formData>
        <camunda:taskListener event="complete" class="com.example.derogation.NotifyNextActorListener" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Soumission</bpmn:incoming>
      <bpmn:incoming>Flow_Retour_Complement_DA</bpmn:incoming>
      <bpmn:incoming>Flow_Retour_Complement_DIE</bpmn:incoming>
      <bpmn:incoming>Flow_Retour_Analyse_Incomplete</bpmn:incoming>
      <bpmn:incoming>Flow_Retour_Refus_Reseau</bpmn:incoming>
      <bpmn:outgoing>Flow_Soumission_GwInit</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: initiée par le Conseiller ? -->
    <bpmn:exclusiveGateway id="Gateway_InitieeParConseiller" name="Soumission par conseiller ?" default="Flow_Skip_DA">
      <bpmn:incoming>Flow_Soumission_GwInit</bpmn:incoming>
      <bpmn:outgoing>Flow_Vers_ValidationDA</bpmn:outgoing>
      <bpmn:outgoing>Flow_Skip_DA</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Validation DA -->
    <bpmn:userTask id="Task_ValidationDA"
                   name="Valider demande DA"
                   camunda:candidateGroups="da">
      <bpmn:documentation>Validation par le Directeur d'Agence (si initiée par le Conseiller)</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="decisionDA" label="Décision DA" type="enum">
            <camunda:value id="valide" name="Validée" />
            <camunda:value id="complement" name="Complément requis" />
          </camunda:formField>
          <camunda:formField id="commentaireDA" label="Commentaire" type="string" />
        </camunda:formData>
        <camunda:taskListener event="complete" class="com.example.derogation.NotifyNextActorListener" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Vers_ValidationDA</bpmn:incoming>
      <bpmn:outgoing>Flow_DA_GwDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: DA validée ou retour complément ? -->
    <bpmn:exclusiveGateway id="Gateway_DecisionDA" name="Validation DA complète ?" default="Flow_DA_Vers_DIE">
      <bpmn:incoming>Flow_DA_GwDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_DA_Vers_DIE</bpmn:outgoing>
      <bpmn:outgoing>Flow_Retour_Complement_DA</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Validation DIE -->
    <bpmn:userTask id="Task_ValidationDIE"
                   name="Valider demande DIE"
                   camunda:candidateGroups="die">
      <bpmn:documentation>Validation DIE — Après validation du DA</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="decisionDIE" label="Décision DIE" type="enum">
            <camunda:value id="valide" name="Validée" />
            <camunda:value id="complement" name="Complément requis" />
          </camunda:formField>
          <camunda:formField id="commentaireDIE" label="Commentaire" type="string" />
        </camunda:formData>
        <camunda:taskListener event="complete" class="com.example.derogation.NotifyNextActorListener" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DA_Vers_DIE</bpmn:incoming>
      <bpmn:incoming>Flow_Skip_DA</bpmn:incoming>
      <bpmn:outgoing>Flow_DIE_GwDecision</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: DIE validée ou retour complément ? -->
    <bpmn:exclusiveGateway id="Gateway_DecisionDIE" name="Validation DIE complète ?" default="Flow_DIE_Vers_LigneMetier">
      <bpmn:incoming>Flow_DIE_GwDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_DIE_Vers_LigneMetier</bpmn:outgoing>
      <bpmn:outgoing>Flow_Retour_Complement_DIE</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Ligne Métier -->
    <bpmn:userTask id="Task_LigneMetier"
                   name="Analyser demande"
                   camunda:candidateGroups="ligne_metier">
      <bpmn:documentation>Étude et réponse : Positif / Négatif / Contre-proposition.
Si le dossier ne permet pas de conclure, l'analyse est déclarée incomplète et la demande repart à la soumission,
selon la même logique que les validations DA et DIE.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="analyseComplete" label="Analyse complète" type="boolean" defaultValue="true" />
          <camunda:formField id="sensReponse" label="Sens de la réponse" type="enum">
            <camunda:value id="positif" name="Positif" />
            <camunda:value id="negatif" name="Négatif" />
            <camunda:value id="contre_proposition" name="Contre-proposition" />
          </camunda:formField>
          <camunda:formField id="reponseLigneMetier" label="Réponse / conditions" type="string" />
        </camunda:formData>
        <camunda:taskListener event="complete" class="com.example.derogation.NotifyNextActorListener" />
        <camunda:taskListener event="complete" class="com.example.derogation.NotifyReseauActorsListener" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DIE_Vers_LigneMetier</bpmn:incoming>
      <bpmn:outgoing>Flow_LigneMetier_GwAnalyse</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: analyse complète ? (même logique que DA / DIE) -->
    <bpmn:exclusiveGateway id="Gateway_AnalyseComplete" name="Analyse complète ?" default="Flow_Analyse_Complete">
      <bpmn:incoming>Flow_LigneMetier_GwAnalyse</bpmn:incoming>
      <bpmn:outgoing>Flow_Analyse_Complete</bpmn:outgoing>
      <bpmn:outgoing>Flow_Retour_Analyse_Incomplete</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Décision du réseau sur la réponse de la Ligne Métier -->
    <bpmn:userTask id="Task_ReponseReseau"
                   name="Statuer sur la réponse Ligne Métier"
                   camunda:candidateGroups="conseiller,da">
      <bpmn:documentation>La main revient au réseau (même groupe que la soumission) une fois l'analyse terminée :
le conseiller ou le DA valide la réponse — le récapitulatif est alors généré — ou la refuse, et la demande repart à la soumission.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="reponseAcceptee" label="Réponse acceptée" type="boolean" />
          <camunda:formField id="motifRefus" label="Motif du refus" type="string" />
        </camunda:formData>
        <camunda:taskListener event="complete" class="com.example.derogation.NotifyNextActorListener" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Analyse_Complete</bpmn:incoming>
      <bpmn:outgoing>Flow_Reponse_GwAccept</bpmn:outgoing>
    </bpmn:userTask>

    <!-- Gateway: Réponse acceptée par le réseau ? -->
    <bpmn:exclusiveGateway id="Gateway_ReponseAcceptee" name="Réponse validée par le réseau ?" default="Flow_Oui_Fin">
      <bpmn:incoming>Flow_Reponse_GwAccept</bpmn:incoming>
      <bpmn:outgoing>Flow_Oui_Fin</bpmn:outgoing>
      <bpmn:outgoing>Flow_Retour_Refus_Reseau</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Édition document récapitulatif -->
    <bpmn:serviceTask id="Task_EditionRecap"
                      name="Générer récapitulatif"
                      camunda:class="com.example.derogation.GenerateRecapDocumentDelegate">
      <bpmn:documentation>Points échangés, conditions acceptées, historique des validateurs</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener event="end" class="com.example.derogation.NotifyNextActorListener" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Oui_Fin</bpmn:incoming>
      <bpmn:outgoing>Flow_Recap_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- End -->
    <bpmn:endEvent id="EndEvent_FinWorkflow" name="Processus terminé">
      <bpmn:incoming>Flow_Recap_End</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_Start_Soumission" sourceRef="StartEvent_NouvelleDemande" targetRef="Task_Soumission" />

    <bpmn:sequenceFlow id="Flow_Soumission_GwInit" sourceRef="Task_Soumission" targetRef="Gateway_InitieeParConseiller" />

    <bpmn:sequenceFlow id="Flow_Vers_ValidationDA" name="Oui" sourceRef="Gateway_InitieeParConseiller" targetRef="Task_ValidationDA">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${initiateur == 'conseiller'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Skip_DA" name="Non" sourceRef="Gateway_InitieeParConseiller" targetRef="Task_ValidationDIE" />

    <bpmn:sequenceFlow id="Flow_DA_GwDecision" sourceRef="Task_ValidationDA" targetRef="Gateway_DecisionDA" />

    <bpmn:sequenceFlow id="Flow_DA_Vers_DIE" name="Complète" sourceRef="Gateway_DecisionDA" targetRef="Task_ValidationDIE" />

    <bpmn:sequenceFlow id="Flow_Retour_Complement_DA" name="Complément requis" sourceRef="Gateway_DecisionDA" targetRef="Task_Soumission">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decisionDA == 'complement'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_DIE_GwDecision" sourceRef="Task_ValidationDIE" targetRef="Gateway_DecisionDIE" />

    <bpmn:sequenceFlow id="Flow_DIE_Vers_LigneMetier" name="Complète" sourceRef="Gateway_DecisionDIE" targetRef="Task_LigneMetier" />

    <bpmn:sequenceFlow id="Flow_Retour_Complement_DIE" name="Complément requis" sourceRef="Gateway_DecisionDIE" targetRef="Task_Soumission">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decisionDIE == 'complement'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_LigneMetier_GwAnalyse" sourceRef="Task_LigneMetier" targetRef="Gateway_AnalyseComplete" />

    <bpmn:sequenceFlow id="Flow_Analyse_Complete" name="Complète" sourceRef="Gateway_AnalyseComplete" targetRef="Task_ReponseReseau" />

    <bpmn:sequenceFlow id="Flow_Retour_Analyse_Incomplete" name="Analyse incomplète" sourceRef="Gateway_AnalyseComplete" targetRef="Task_Soumission">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!analyseComplete}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Reponse_GwAccept" sourceRef="Task_ReponseReseau" targetRef="Gateway_ReponseAcceptee" />

    <bpmn:sequenceFlow id="Flow_Oui_Fin" name="Validée" sourceRef="Gateway_ReponseAcceptee" targetRef="Task_EditionRecap" />

    <bpmn:sequenceFlow id="Flow_Retour_Refus_Reseau" name="Refusée" sourceRef="Gateway_ReponseAcceptee" targetRef="Task_Soumission">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!reponseAcceptee}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Recap_End" sourceRef="Task_EditionRecap" targetRef="EndEvent_FinWorkflow" />

    <!-- Text Annotations -->
    <bpmn:textAnnotation id="Annotation_NotificationEmail">
      <bpmn:text>Notification email systématique après chaque étape franchie, pour informer le prochain acteur concerné.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_NotificationEmail" sourceRef="Task_Soumission" targetRef="Annotation_NotificationEmail" />

    <bpmn:textAnnotation id="Annotation_AnalyseIncomplete">
      <bpmn:text>Analyse incomplète : même logique que les validations DA et DIE — le jeton repart à la soumission pour complément.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_AnalyseIncomplete" sourceRef="Gateway_AnalyseComplete" targetRef="Annotation_AnalyseIncomplete" />

    <bpmn:textAnnotation id="Annotation_RetourLigneMetier">
      <bpmn:text>La main revient au réseau (conseiller / DA, même groupe que la soumission). En cas de refus, les 3 acteurs réseau sont informés — Conseiller/RM, DA, DIE — et la demande repart à la soumission.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_RetourLigneMetier" sourceRef="Task_ReponseReseau" targetRef="Annotation_RetourLigneMetier" />

    <bpmn:textAnnotation id="Annotation_Legende">
      <bpmn:text>Légende :
— Avancement du parcours
— Retour vers la soumission (en rouge)</bpmn:text>
    </bpmn:textAnnotation>

  </bpmn:process>

  <bpmn:collaboration id="Collaboration_Derogation">
    <bpmn:participant id="Participant_Derogation" name="Workflow de demande de dérogation" processRef="Process_Derogation" />
  </bpmn:collaboration>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Derogation">
    <bpmndi:BPMNPlane id="BPMNPlane_Derogation" bpmnElement="Collaboration_Derogation">

      <bpmndi:BPMNShape id="Shape_Participant_Derogation" bpmnElement="Participant_Derogation" isHorizontal="true" bioc:stroke="#5B6B7A" bioc:fill="#FFFFFF" color:border-color="#5B6B7A" color:background-color="#FFFFFF">
        <dc:Bounds x="20" y="20" width="2240" height="500" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Lane_Reseau" bpmnElement="Lane_Reseau" isHorizontal="true" bioc:stroke="#B8C4CE" bioc:fill="#F7FAFC" color:border-color="#B8C4CE" color:background-color="#F7FAFC">
        <dc:Bounds x="50" y="20" width="2210" height="120" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Lane_DA" bpmnElement="Lane_DA" isHorizontal="true" bioc:stroke="#B8C4CE" bioc:fill="#FDF8F2" color:border-color="#B8C4CE" color:background-color="#FDF8F2">
        <dc:Bounds x="50" y="140" width="2210" height="120" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Lane_DIE" bpmnElement="Lane_DIE" isHorizontal="true" bioc:stroke="#B8C4CE" bioc:fill="#F5F7FF" color:border-color="#B8C4CE" color:background-color="#F5F7FF">
        <dc:Bounds x="50" y="260" width="2210" height="120" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Lane_LigneMetier" bpmnElement="Lane_LigneMetier" isHorizontal="true" bioc:stroke="#B8C4CE" bioc:fill="#F4FBF7" color:border-color="#B8C4CE" color:background-color="#F4FBF7">
        <dc:Bounds x="50" y="380" width="2210" height="140" />
      </bpmndi:BPMNShape>

      <!-- Start Event -->
      <bpmndi:BPMNShape id="Shape_StartEvent_NouvelleDemande" bpmnElement="StartEvent_NouvelleDemande" bioc:stroke="#2E7D32" bioc:fill="#E8F5E9" color:border-color="#2E7D32" color:background-color="#E8F5E9">
        <dc:Bounds x="90" y="62" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Soumission -->
      <bpmndi:BPMNShape id="Shape_Task_Soumission" bpmnElement="Task_Soumission" bioc:stroke="#5B6B7A" bioc:fill="#FFFFFF" color:border-color="#5B6B7A" color:background-color="#FFFFFF">
        <dc:Bounds x="180" y="40" width="180" height="80" />
      </bpmndi:BPMNShape>

      <!-- Gateway Init -->
      <bpmndi:BPMNShape id="Shape_Gateway_InitieeParConseiller" bpmnElement="Gateway_InitieeParConseiller" isMarkerVisible="true" bioc:stroke="#6C7A89" bioc:fill="#FFF8E1" color:border-color="#6C7A89" color:background-color="#FFF8E1">
        <dc:Bounds x="420" y="55" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- Validation DA -->
      <bpmndi:BPMNShape id="Shape_Task_ValidationDA" bpmnElement="Task_ValidationDA" bioc:stroke="#8A6D3B" bioc:fill="#FFF3E0" color:border-color="#8A6D3B" color:background-color="#FFF3E0">
        <dc:Bounds x="530" y="160" width="180" height="80" />
      </bpmndi:BPMNShape>

      <!-- Gateway Decision DA -->
      <bpmndi:BPMNShape id="Shape_Gateway_DecisionDA" bpmnElement="Gateway_DecisionDA" isMarkerVisible="true" bioc:stroke="#8A6D3B" bioc:fill="#FFF8E1" color:border-color="#8A6D3B" color:background-color="#FFF8E1">
        <dc:Bounds x="760" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- Validation DIE -->
      <bpmndi:BPMNShape id="Shape_Task_ValidationDIE" bpmnElement="Task_ValidationDIE" bioc:stroke="#4E5BA6" bioc:fill="#EEF2FF" color:border-color="#4E5BA6" color:background-color="#EEF2FF">
        <dc:Bounds x="880" y="280" width="180" height="80" />
      </bpmndi:BPMNShape>

      <!-- Gateway Decision DIE -->
      <bpmndi:BPMNShape id="Shape_Gateway_DecisionDIE" bpmnElement="Gateway_DecisionDIE" isMarkerVisible="true" bioc:stroke="#4E5BA6" bioc:fill="#F5F3FF" color:border-color="#4E5BA6" color:background-color="#F5F3FF">
        <dc:Bounds x="1110" y="295" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- Ligne Métier -->
      <bpmndi:BPMNShape id="Shape_Task_LigneMetier" bpmnElement="Task_LigneMetier" bioc:stroke="#1F6F54" bioc:fill="#E8F5EE" color:border-color="#1F6F54" color:background-color="#E8F5EE">
        <dc:Bounds x="1230" y="410" width="180" height="80" />
      </bpmndi:BPMNShape>

      <!-- Gateway Analyse complète -->
      <bpmndi:BPMNShape id="Shape_Gateway_AnalyseComplete" bpmnElement="Gateway_AnalyseComplete" isMarkerVisible="true" bioc:stroke="#1F6F54" bioc:fill="#FFF8E1" color:border-color="#1F6F54" color:background-color="#FFF8E1">
        <dc:Bounds x="1460" y="425" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- Décision réseau -->
      <bpmndi:BPMNShape id="Shape_Task_ReponseReseau" bpmnElement="Task_ReponseReseau" bioc:stroke="#5B6B7A" bioc:fill="#FFFFFF" color:border-color="#5B6B7A" color:background-color="#FFFFFF">
        <dc:Bounds x="1570" y="40" width="180" height="80" />
      </bpmndi:BPMNShape>

      <!-- Gateway Réponse acceptée -->
      <bpmndi:BPMNShape id="Shape_Gateway_ReponseAcceptee" bpmnElement="Gateway_ReponseAcceptee" isMarkerVisible="true" bioc:stroke="#6C7A89" bioc:fill="#FFF8E1" color:border-color="#6C7A89" color:background-color="#FFF8E1">
        <dc:Bounds x="1810" y="55" width="50" height="50" />
      </bpmndi:BPMNShape>

      <!-- Édition récap -->
      <bpmndi:BPMNShape id="Shape_Task_EditionRecap" bpmnElement="Task_EditionRecap" bioc:stroke="#5B6B7A" bioc:fill="#FFFFFF" color:border-color="#5B6B7A" color:background-color="#FFFFFF">
        <dc:Bounds x="1900" y="40" width="180" height="80" />
      </bpmndi:BPMNShape>

      <!-- End Event -->
      <bpmndi:BPMNShape id="Shape_EndEvent_FinWorkflow" bpmnElement="EndEvent_FinWorkflow" bioc:stroke="#455A64" bioc:fill="#ECEFF1" color:border-color="#455A64" color:background-color="#ECEFF1">
        <dc:Bounds x="2140" y="62" width="36" height="36" />
      </bpmndi:BPMNShape>

      <!-- Annotations -->
      <bpmndi:BPMNShape id="Shape_Annotation_NotificationEmail" bpmnElement="Annotation_NotificationEmail">
        <dc:Bounds x="180" y="800" width="260" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Annotation_Legende" bpmnElement="Annotation_Legende">
        <dc:Bounds x="520" y="540" width="240" height="70" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Annotation_AnalyseIncomplete" bpmnElement="Annotation_AnalyseIncomplete">
        <dc:Bounds x="1230" y="540" width="240" height="90" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Annotation_RetourLigneMetier" bpmnElement="Annotation_RetourLigneMetier">
