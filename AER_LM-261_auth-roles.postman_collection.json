{
  "info": {
    "name": "AER_LM-261 - Authentification et rôles (contexte GDF)",
    "description": "Prérequis : V16 appliquée + seed-local-gdf-users.sql (g10001..g10004). auth-mode: mock. Le JWT est fabriqué par le script de pré-requête de chaque appel.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Contexte - Chef de caisse (g10002)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Mode local (qf.security.auth-mode = mock) : QfSimplifiedAuthFilter lit seulement le claim `sub`",
              "// et ne verifie pas la signature. On fabrique un JWT HS256 avec sub = uid a chaque appel.",
              "const uid = 'g10002';",
              "const b64url = words => CryptoJS.enc.Base64.stringify(words).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
              "const header  = b64url(CryptoJS.enc.Utf8.parse(JSON.stringify({ alg: 'HS256', typ: 'JWT' })));",
              "const payload = b64url(CryptoJS.enc.Utf8.parse(JSON.stringify({ sub: uid, iss: 'postman-mock', iat: Math.floor(Date.now() / 1000), exp: Math.floor(Date.now() / 1000) + 3600 })));",
              "const signature = b64url(CryptoJS.HmacSHA256(header + '.' + payload, 'mock-secret'));",
              "pm.variables.set('token', header + '.' + payload + '.' + signature);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('success = true', () => pm.expect(body.success).to.eql(true));",
              "pm.test('profileCode = CHEF_CAISSE', () => pm.expect(body.data.profileCode).to.eql('CHEF_CAISSE'));",
              "pm.test('toutesAgences = false', () => pm.expect(body.data.toutesAgences).to.eql(false));",
              "pm.test('permissions exactes', () => pm.expect(body.data.permissions).to.eql([\"GDF_ANNULER_DEMANDE\", \"GDF_CONSULTER_DEMANDE\", \"GDF_CREER_DEMANDE\", \"GDF_MODIFIER_DEMANDE\"]));",
              "pm.test('agence.code = 1422', () => pm.expect(body.data.agence.code).to.eql('1422'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/public/users/me/context",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "public",
            "users",
            "me",
            "context"
          ]
        }
      }
    },
