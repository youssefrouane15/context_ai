      <bpmndi:BPMNShape id="Shape_EventSubProcess_Annulation" bpmnElement="EventSubProcess_Annulation" isExpanded="true"
                        bioc:stroke="#a11f1f" bioc:fill="#fdeeee" color:border-color="#a11f1f" color:background-color="#fdeeee">
        <dc:Bounds x="230" y="1050" width="500" height="200" />
