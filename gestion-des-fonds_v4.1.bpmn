        <dc:Bounds x="2000" y="362" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_AnnuleeParCaisseCentrale" bpmnElement="EndEvent_AnnuleeParCaisseCentrale"
                        bioc:stroke="#a11f1f" bioc:fill="#fadbdb" color:border-color="#a11f1f" color:background-color="#fadbdb">
        <dc:Bounds x="2000" y="482" width="36" height="36" />
