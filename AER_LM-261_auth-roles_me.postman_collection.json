{
  "info": {
    "name": "AER_LM-261 - Authentification et rôles (GET /me enrichi gestionFonds)",
    "description": "Prérequis : V16 appliquée (checksum corrigé) + seed-local-gdf-users.sql (g10001..g10004). auth-mode: mock. JWT fabriqué en pré-requête. Remplace les collections précédentes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Me - Chef de caisse (g10002)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Mode local (qf.security.auth-mode = mock) : QfSimplifiedAuthFilter lit seulement le claim `sub`",
              "// et ne verifie pas la signature. On fabrique un JWT HS256 avec sub = uid a chaque appel.",
              "const uid = 'g10002';",
              "const b64url = words => CryptoJS.enc.Base64.stringify(words).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
              "const header  = b64url(CryptoJS.enc.Utf8.parse(JSON.stringify({ alg: 'HS256', typ: 'JWT' })));",
              "const payload = b64url(CryptoJS.enc.Utf8.parse(JSON.stringify({ sub: uid, iss: 'postman-mock', iat: Math.floor(Date.now() / 1000), exp: Math.floor(Date.now() / 1000) + 3600 })));",
              "const signature = b64url(CryptoJS.HmacSHA256(header + '.' + payload, 'mock-secret'));",
              "pm.variables.set('token', header + '.' + payload + '.' + signature);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('uid present', () => pm.expect(body.uid).to.be.a('string'));",
              "pm.test('profile.code = CHEF_CAISSE', () => pm.expect(body.profile.code).to.eql('CHEF_CAISSE'));",
              "pm.test('bloc gestionFonds present', () => pm.expect(body.gestionFonds).to.be.an('object'));",
              "pm.test('gestionFonds.permissions exactes', () => pm.expect([...body.gestionFonds.permissions].sort()).to.eql([\"GDF_ANNULER_DEMANDE\", \"GDF_CONSULTER_DEMANDE\", \"GDF_CREER_DEMANDE\", \"GDF_MODIFIER_DEMANDE\"]));",
              "pm.test('gestionFonds.toutesAgences = false', () => pm.expect(body.gestionFonds.toutesAgences).to.eql(false));",
              "pm.test('gestionFonds.agence.code = 1422', () => pm.expect(body.gestionFonds.agence.code).to.eql('1422'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/public/users/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "public",
            "users",
            "me"
          ]
        }
      }
    },
