{
  "info": {
    "name": "QlickFlow — AER_LM-277 — /internal/users (DA via orgaUnit.manager)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Canal interne utilisateurs-ci (8091, non routé par la gateway). Vérifie que la fiche d'un utilisateur expose son agence et le manager de l'agence (= Directeur d'agence) avec son email, ce que fund-management lit pour la notification 277."
  },
  "variable": [
    {
      "key": "usersBaseUrl",
      "value": "http://localhost:8091"
    }
  ],
  "item": [
    {
      "name": "1. Chef de caisse j62211 → DA de 1104",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{usersBaseUrl}}/api/v1/internal/users/j62211",
          "host": [
            "{{usersBaseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "internal",
            "users",
            "j62211"
          ]
        },
        "description": "Youness BALADI (chef de caisse 1104). Le manager de son agence doit être Marouane MASSOUNE (j61104)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const u = pm.response.json();",
              "pm.test('uid = j62211', () => pm.expect(u.uid).to.eql('j62211'));",
              "pm.test('orgaUnit présent (agence)', () => { pm.expect(u.orgaUnit).to.be.an('object'); pm.expect(u.orgaUnit.type).to.eql('AGENCE'); });",
              "pm.test('agence 1104', () => pm.expect(u.orgaUnit.code).to.eql('1104'));",
              "pm.test('orgaUnit.manager présent (= DA)', () => pm.expect(u.orgaUnit.manager, 'manager_id non renseigné sur l\\'agence : UPDATE orga_unit de V20').to.be.an('object'));",
              "pm.test('manager.uid = j61104', () => pm.expect(u.orgaUnit.manager.uid).to.eql('j61104'));",
              "pm.test('manager.email = j61104@bnpparibas.com', () => pm.expect(u.orgaUnit.manager.email, 'email absent : ajouter le champ sur SimpleUserDTO + mapper').to.eql('j61104@bnpparibas.com'));",
              "console.log('DA :', JSON.stringify(u.orgaUnit.manager));"
            ]
          }
        }
      ],
      "response": []
    },
    {
