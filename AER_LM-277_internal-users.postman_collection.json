    {
      "name": "4. Caisse Centrale c63005 → pas d'agence",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{usersBaseUrl}}/api/v1/internal/users/c63005",
          "host": [
            "{{usersBaseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "internal",
            "users",
            "c63005"
          ]
        },
        "description": "Yassine SMATOU. Pas de DA attendu : la Caisse Centrale ne déclenche de toute façon pas d'email."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const u = pm.response.json();",
              "pm.test('uid = c63005', () => pm.expect(u.uid).to.eql('c63005'));",
              "pm.test('aucune agence (profil toutes agences)', () => pm.expect(u.orgaUnit === null || u.orgaUnit === undefined || u.orgaUnit.type !== 'AGENCE').to.be.true);",
              "pm.test('profil CAISSE_CENTRALE', () => pm.expect(u.profile && u.profile.code).to.eql('CAISSE_CENTRALE'));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "5. Agence sans manager (1422, j43709) → manager null",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{usersBaseUrl}}/api/v1/internal/users/j43709",
          "host": [
            "{{usersBaseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "internal",
            "users",
            "j43709"
          ]
        },
        "description": "Cas limite : agence sans manager_id. Si tu as renseigné un manager sur 1422, ce test échoue — c'est attendu."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const u = pm.response.json();",
              "pm.test('agence 1422', () => pm.expect(u.orgaUnit && u.orgaUnit.code).to.eql('1422'));",
              "pm.test('manager absent (cas « aucun DA » → warn fund-management, demande non bloquée)', () => pm.expect(u.orgaUnit.manager == null).to.be.true);",
              "console.log('Si ce test échoue, 1422 a un manager : adapter l\\'attendu ou tester avec une autre agence.');"
            ]
          }
        }
      ],
      "response": []
    },
