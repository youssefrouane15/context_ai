              "pm.test('manager.email = j61104@bnpparibas.com', () => pm.expect(u.orgaUnit.manager.email, 'email absent : ajouter le champ sur SimpleUserDTO + mapper').to.eql('j61104@bnpparibas.com'));",
              "console.log('DA :', JSON.stringify(u.orgaUnit.manager));"
            ]
