{
  "info": {
    "name": "QlickFlow — AER_LM-277 — Directeur d'agence par code agence",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "utilisateurs-ci (8091), canal interne. GET /api/v1/internal/users/agences/{code}/directeur = utilisateur actif, profil DA, rattaché à l'agence."
  },
  "variable": [
    {
      "key": "usersBaseUrl",
      "value": "http://localhost:8091"
    }
  ],
  "item": [
    {
      "name": "1. Agence 1104 → DA Marouane MASSOUNE",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{usersBaseUrl}}/api/v1/internal/users/agences/1104/directeur",
          "host": [
            "{{usersBaseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "internal",
            "users",
            "agences",
            "1104",
            "directeur"
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test('success', () => pm.expect(r.success).to.be.true);",
              "pm.test('uid j61104', () => pm.expect(r.data.uid).to.eql('j61104'));",
              "pm.test('email renseigné', () => pm.expect(r.data.email).to.match(/@/));",
              "console.log('DA 1104 :', JSON.stringify(r.data));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "2. Agence sans DA actif → 404",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{usersBaseUrl}}/api/v1/internal/users/agences/9999/directeur",
          "host": [
            "{{usersBaseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "internal",
            "users",
            "agences",
            "9999",
            "directeur"
          ]
        },
        "description": "Côté fund-management : warn « aucun Directeur d'agence », demande non impactée."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404', () => pm.response.to.have.status(404));",
              "pm.test('success=false', () => pm.expect(pm.response.json().success).to.be.false);"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "3. Code en minuscules / casse ignorée",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{usersBaseUrl}}/api/v1/internal/users/agences/1104/directeur",
          "host": [
            "{{usersBaseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "internal",
            "users",
            "agences",
            "1104",
            "directeur"
          ]
        },
        "description": "Les codes agence sont numériques ; la requête est IgnoreCase par sécurité."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "response": []
    }
  ]
}