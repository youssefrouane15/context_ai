              "const d = pm.response.json().data; pm.test('56 GAB chargés', () => pm.expect(d.length).to.be.at.least(56));",
              "const g = d.find(x => x.idGab === '130120017'); pm.test('130120017 rattaché à 1120', () => pm.expect(g.agence.code).to.eql('1120'));",
              "pm.test('défauts BRINKS / 0 / H / EN_LIGNE', () => { pm.expect(g.transporteur.id).to.eql('BRINKS'); pm.expect(g.prixUnitaire).to.eql(0); pm.expect(g.type).to.eql('H'); pm.expect(g.etat).to.eql('EN_LIGNE'); });",
              "pm.environment.set('agenceId1120', g.agence.id); pm.environment.set('gabId', g.id);"
            ]
          }
        }
      ]
