{
  "info": {
    "name": "AER_LM-311-300-312 GAB hors site",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ordre : 00 → 17. Variables : baseUrl = http://localhost:9090 (gateway) sauf la 16 (http://localhost:8091), token = JWT du mock login."
  },
  "item": [
    {
      "name": "00 - Jeton (mock) : POST /mock-auth/login?uid=h11111",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/mock-auth/login?uid=h11111",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "mock-auth",
            "login"
          ],
          "query": [
            {
              "key": "uid",
              "value": "h11111"
            }
          ]
        },
        "description": "Gateway 9090. En mode mock, le cookie QF_MOCK_SESSION porte le JWT ; sinon copier le Bearer dans la variable {{token}}. h11111 a GDF_GERER_GAB via V23 (rôle 8)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const c = pm.cookies.get('QF_MOCK_SESSION'); if (c) pm.environment.set('token', c);"
            ]
          }
        }
      ]
    },
